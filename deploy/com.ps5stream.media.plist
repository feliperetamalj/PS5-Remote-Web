<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ps5stream.media</string>
  <key>UserName</key><string>__USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/media/build/out/media</string>
    <string>serve</string>
    <string>__HOME__/.config/ps5-stream/ps5.json</string>
    <string>__HOME__/.config/ps5-stream/media.sock</string>
    <string>50000</string>
    <string>__PUBLIC__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ps5-stream/media.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ps5-stream/media.log</string>
</dict>
</plist>
