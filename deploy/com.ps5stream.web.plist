<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ps5stream.web</string>
  <key>UserName</key><string>__USER__</string>
  <key>WorkingDirectory</key><string>__REPO__/web</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>server/index.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key><string>production</string>
    <key>HOME</key><string>__HOME__</string>
    <key>PS5_CONFIG</key><string>__HOME__/.config/ps5-stream/config.json</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ps5-stream/web.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ps5-stream/web.log</string>
</dict>
</plist>
